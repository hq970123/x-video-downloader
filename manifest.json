{
  "manifest_version": 3,
  "name": "X 视频下载器",
  "version": "0.8.2",
  "description": "在 X/Twitter 视频帖子下显示下载按钮，并支持选择清晰度下载。",
  "permissions": ["downloads","storage"],
  "host_permissions": ["https://x.com/*","https://twitter.com/*","https://video.twimg.com/*"],
  "background": {"service_worker":"background/service-worker.js"},
  "action": {"default_popup":"popup/popup.html","default_title":"X Video Downloader","default_icon":{"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}},
  "content_scripts": [{"matches":["https://x.com/*","https://twitter.com/*"],"js":["content/page-hook.js"],"run_at":"document_start","world":"MAIN"},{"matches":["https://x.com/*","https://twitter.com/*"],"js":["content/content.js"],"css":["content/content.css"],"run_at":"document_idle"}],
  "icons":{"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}
}